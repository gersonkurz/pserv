<?xml version='1.0' encoding='utf-8'?>
<setup>
    <!-- Setup script uses MSIS - see https://github.com/gersonkurz/msis -->
    <!-- PRODUCT_VERSION mirrors pserv5/version.h; keep in sync via `just version X.Y.Z`. -->
    <set name="PRODUCT_NAME" value="pserv6 x64"/>
    <set name="PRODUCT_VERSION" value="6.0.0"/>
    <set name="LANGUAGE" value="en-us"/>
    <set name="PLATFORM" value="x64"/>
    <set name="REPAIR_ENABLED" value="True"/>
    <set name="REMOVE_ENABLED" value="True"/>
    <set name="BUILD_TARGET" value="pserv{{PRODUCT_VERSION}} x64.msi"/>
    <set name="UPGRADE_CODE" value="672E9734-DC0A-4FD9-B25E-8544C621B230"/>
    <set name="MANUFACTURER" value="https://github.com/gersonkurz/pserv"/>
    <set name="INSTALLDIR" value="pserv5"/>
    <set name="ADD_TO_PATH" value="True"/>

    <requires type="vcredist" version="2026"/>

    <feature name="pserv5" enabled="yes" allowed="no">
        <files source="..\\dist\\stage\\x64" target="INSTALLDIR"/>

        <feature name="Debug Symbols" enabled="yes" allowed="yes">
            <files source="..\\dist\\symbols\\x64" target="INSTALLDIR"/>
        </feature>

        <feature name="Start-Menu Shortcut" enabled="yes" allowed="yes">
            <shortcut name="pserv5"
                    target="STARTMENU"
                    file="[INSTALLDIR]pserv5.exe"
                    description="Windows system administration tool"/>
        </feature>
    </feature>
</setup>
