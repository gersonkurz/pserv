<?xml version='1.0' encoding='utf-8'?>
<setup>
    <!-- Setup script uses MSIS - see https://github.com/gersonkurz/msis -->
    <!-- PRODUCT_VERSION mirrors pserv6/version.h; keep in sync via `just version X.Y.Z`. -->
    <!-- UPGRADE_CODE is pserv5's: one MSI lineage, so installing pserv6 upgrades pserv5 away (plan D12). -->
    <set name="PRODUCT_NAME" value="pserv6 ARM64"/>
    <set name="PRODUCT_VERSION" value="6.0.0"/>
    <set name="LANGUAGE" value="en-us"/>
    <set name="PLATFORM" value="arm64"/>
    <set name="REPAIR_ENABLED" value="True"/>
    <set name="REMOVE_ENABLED" value="True"/>
    <set name="BUILD_TARGET" value="pserv6-{{PRODUCT_VERSION}}-arm64.msi"/>
    <set name="UPGRADE_CODE" value="672E9734-DC0A-4FD9-B25E-8544C621B230"/>
    <set name="MANUFACTURER" value="https://github.com/gersonkurz/pserv"/>
    <set name="INSTALLDIR" value="pserv6"/>
    <set name="ADD_TO_PATH" value="True"/>

    <requires type="vcredist" version="2026"/>

    <!-- Payload: pserv6.exe with its self-contained WinAppSDK runtime files, and pservc.exe
         (staged by `just package-arm64` from pserv6\bin). The .pdb files are an optional feature, not
         installed unless selected (owner, 2026-11-22); they about double the size of the MSI. -->
    <feature name="pserv6" enabled="yes" allowed="no">
        <files source="..\dist\stage\arm64" target="INSTALLDIR"/>

        <feature name="Start-Menu Shortcut" enabled="yes" allowed="yes">
            <shortcut name="pserv6"
                    target="STARTMENU"
                    file="[INSTALLDIR]pserv6.exe"
                    description="Windows system administration tool"/>
        </feature>

        <feature name="Debug Symbols" enabled="no" allowed="yes">
            <files source="..\dist\symbols\arm64" target="INSTALLDIR"/>
        </feature>
    </feature>
</setup>
