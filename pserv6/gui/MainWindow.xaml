<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="pserv6.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="pserv6">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid x:Name="Root" RowDefinitions="Auto,*">
    <!-- Never shown: these resolve the theme brushes the grid paints with. ThemeResource follows the
         window's theme, so the code reads the brushes from here after every theme change. -->
    <StackPanel Visibility="Collapsed">
        <TextBlock x:Name="BrushNormal" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
        <TextBlock x:Name="BrushHighlight" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
        <TextBlock x:Name="BrushDisabled" Foreground="{ThemeResource TextFillColorDisabledBrush}" />
        <Border x:Name="BrushGripper" Background="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
        <Border x:Name="BrushHover" Background="{ThemeResource SubtleFillColorTertiaryBrush}" />
    </StackPanel>
    <MenuBar x:Name="MainMenu">
        <MenuBarItem Title="File" AccessKey="F">
            <MenuFlyoutItem Text="Refresh" Click="OnRefreshClick" KeyboardAcceleratorTextOverride="F5">
                <MenuFlyoutItem.Icon><SymbolIcon Symbol="Refresh" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem x:Name="ConnectRemoteItem" Text="Connect to Remote Machine..." Click="OnConnectRemote" />
            <MenuFlyoutItem x:Name="ConnectLocalItem" Text="Connect to Local Machine" Click="OnConnectLocal" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Text="Exit" Click="OnExit" KeyboardAcceleratorTextOverride="Alt+F4" />
        </MenuBarItem>
        <!-- Filled in code (BuildViewMenu): the views, auto-refresh, theme, zoom -->
        <MenuBarItem x:Name="ViewMenu" Title="View" AccessKey="V" />
        <MenuBarItem Title="Help" AccessKey="H">
            <MenuFlyoutItem Text="Documentation" Click="OnDocumentation" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Text="About pserv6..." Click="OnAbout" />
        </MenuBarItem>
    </MenuBar>
    <NavigationView Grid.Row="1" x:Name="Nav" PaneDisplayMode="Left" IsSettingsVisible="False" IsBackButtonVisible="Collapsed"
                    OpenPaneLength="210" SelectionChanged="OnNavSelectionChanged">
        <Grid RowDefinitions="Auto,*,Auto" Padding="8,6,8,4" RowSpacing="6">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="RefreshButton" Click="OnRefreshClick" ToolTipService.ToolTip="Refresh (F5)">
                    <SymbolIcon Symbol="Refresh" />
                </Button>
                <DropDownButton x:Name="SortButton" AccessKey="S" ToolTipService.ToolTip="Sort by column (Alt+S)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <SymbolIcon Symbol="Sort" />
                        <TextBlock Text="Sort" />
                    </StackPanel>
                </DropDownButton>
                <ToggleSwitch x:Name="AutoRefreshSwitch" OnContent="Auto-refresh" OffContent="Auto-refresh" Toggled="OnAutoRefreshToggled" MinWidth="0" />
                <TextBox x:Name="FilterBox" PlaceholderText="Filter" Width="260" TextChanged="OnFilterChanged" />
            </StackPanel>
            <ScrollViewer Grid.Row="1" x:Name="HScroller" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                <Grid RowDefinitions="Auto,*">
                    <!-- Left-aligned like the rows (a fixed-width element would otherwise be centred) -->
                    <Grid x:Name="HeaderGrid" Height="30" HorizontalAlignment="Left" />
                    <ListView Grid.Row="1" x:Name="RowList" HorizontalAlignment="Left" SelectionMode="Extended" IsItemClickEnabled="False"
                              ContainerContentChanging="OnContainerContentChanging"
                              ContextRequested="OnRowContextRequested" DoubleTapped="OnRowDoubleTapped">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="MinHeight" Value="24" />
                                <Setter Property="Height" Value="24" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <!-- The grid restores the scroll offset itself after a reset; item anchoring would move it again -->
                                <ItemsStackPanel ItemsUpdatingScrollMode="KeepScrollOffset" CacheLength="1" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </ScrollViewer>
            <TextBlock Grid.Row="2" x:Name="StatusText" Opacity="0.8" />
        </Grid>
    </NavigationView>
    </Grid>
</Window>
