<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="pserv6.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="pserv6">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid x:Name="Root" RowDefinitions="Auto,*">
    <!-- Never shown: these resolve the theme brushes the grid paints with. ThemeResource follows the
         window's theme, so the code reads the brushes from here after every theme change. -->
    <StackPanel Visibility="Collapsed">
        <TextBlock x:Name="BrushNormal" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
        <TextBlock x:Name="BrushHighlight" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
        <TextBlock x:Name="BrushDisabled" Foreground="{ThemeResource TextFillColorDisabledBrush}" />
        <Border x:Name="BrushGripper" Background="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
        <Border x:Name="BrushHover" Background="{ThemeResource SubtleFillColorTertiaryBrush}" />
        <Border x:Name="BrushAlternate" Background="{ThemeResource ControlAltFillColorSecondaryBrush}" />
    </StackPanel>
    <!-- One row, which is also the window's title bar (SetTitleBar): title and badge, the menu, the
         toolbar (refresh, sort, auto-refresh, filter, the view's actions), "Run as administrator" and
         room for the caption buttons. The row drags the window except where the code declares the
         controls as pass-through regions (UpdateTitleBarRegions). -->
    <Grid x:Name="TitleBarRow" ColumnDefinitions="Auto,Auto,*,Auto,Auto" MinHeight="48">
    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="14,0,6,0">
        <TextBlock x:Name="TitleText" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" VerticalAlignment="Center" />
        <!-- Which machine the views show, and with which rights -->
        <Border CornerRadius="4" Padding="8,2" VerticalAlignment="Center" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
            <TextBlock x:Name="BadgeText" FontSize="11" Opacity="0.85" />
        </Border>
    </StackPanel>
    <MenuBar Grid.Column="1" x:Name="MainMenu" VerticalAlignment="Center">
        <MenuBarItem Title="File" AccessKey="F">
            <MenuFlyoutItem Text="Refresh" Click="OnRefreshClick" KeyboardAcceleratorTextOverride="F5">
                <MenuFlyoutItem.Icon><SymbolIcon Symbol="Refresh" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem x:Name="ConnectRemoteItem" Text="Connect to Remote Machine..." Click="OnConnectRemote">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8AF;" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem x:Name="ConnectLocalItem" Text="Connect to Local Machine" Click="OnConnectLocal">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7F4;" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem x:Name="ElevateItem" Text="Restart as Administrator" Click="OnElevate">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEA18;" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Text="Exit" Click="OnExit" KeyboardAcceleratorTextOverride="Alt+F4" />
        </MenuBarItem>
        <!-- Filled in code (BuildViewMenu): the views, auto-refresh, theme, zoom -->
        <MenuBarItem x:Name="ViewMenu" Title="View" AccessKey="V" />
        <MenuBarItem Title="Help" AccessKey="H">
            <MenuFlyoutItem Text="Documentation" Click="OnDocumentation">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE897;" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Text="About pserv6..." Click="OnAbout">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE946;" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuBarItem>
    </MenuBar>
        <Grid Grid.Column="2" x:Name="ToolBar" ColumnDefinitions="Auto,Auto,Auto,Auto,*" ColumnSpacing="8" VerticalAlignment="Center" Margin="12,0,8,0">
                <Button x:Name="RefreshButton" Click="OnRefreshClick" ToolTipService.ToolTip="Refresh (F5)">
                    <SymbolIcon Symbol="Refresh" />
                </Button>
                <DropDownButton Grid.Column="1" x:Name="SortButton" AccessKey="S" ToolTipService.ToolTip="Sort by column (Alt+S)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <SymbolIcon Symbol="Sort" />
                        <TextBlock Text="Sort" />
                    </StackPanel>
                </DropDownButton>
                <ToggleSwitch Grid.Column="2" x:Name="AutoRefreshSwitch" OnContent="Auto-refresh" OffContent="Auto-refresh" Toggled="OnAutoRefreshToggled" MinWidth="0" />
                <TextBox Grid.Column="3" x:Name="FilterBox" PlaceholderText="Filter" Width="220" VerticalAlignment="Center" TextChanged="OnFilterChanged" />
                <!-- Filled in code (UpdateActionBar): the view's actions. A CommandBar, so that what does
                     not fit moves into its "..." menu instead of being cut off. Left-aligned: the
                     space it does not need stays part of the title bar. -->
                <CommandBar Grid.Column="4" x:Name="ActionBar" DefaultLabelPosition="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Background="Transparent" />
            </Grid>
        <!-- Shown while pserv6 runs without administrator rights (it starts as the invoker) -->
        <Button Grid.Column="3" x:Name="ElevateButton" Click="OnElevate" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,2,8,2"
                ToolTipService.ToolTip="Restart pserv as administrator: without it, some data is missing and most changes are refused">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon Glyph="&#xEA18;" FontSize="16" />
                <TextBlock Text="Run as administrator" />
            </StackPanel>
        </Button>
        <!-- As wide as the caption buttons (set in code from the title bar's inset) -->
        <Border Grid.Column="4" x:Name="CaptionInset" Width="138" />
    </Grid>
    <NavigationView Grid.Row="1" x:Name="Nav" PaneDisplayMode="Left" IsSettingsVisible="False" IsBackButtonVisible="Collapsed"
                    OpenPaneLength="240" SelectionChanged="OnNavSelectionChanged">
        <Grid RowDefinitions="*,Auto,Auto" Padding="8,6,8,4" RowSpacing="6">
            <!-- The list scrolls in both directions (its scrollbars sit at the edges of the view); the
                 header has a scroller of its own without bars, which the grid keeps at the list's
                 horizontal offset. Its right margin is the vertical scrollbar's track, so both
                 scrollers have the same viewport width. -->
                <Grid RowDefinitions="Auto,*">
                    <ScrollViewer x:Name="HeaderScroller" Margin="0,0,12,0" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled" IsTabStop="False">
                        <!-- Left-aligned like the rows (a fixed-width element would otherwise be centred) -->
                        <Grid x:Name="HeaderGrid" Height="30" HorizontalAlignment="Left" />
                    </ScrollViewer>
                    <ListView Grid.Row="1" x:Name="RowList" SelectionMode="Extended" IsItemClickEnabled="False"
                              ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Visible"
                              ShowsScrollingPlaceholders="False" SelectionChanged="OnRowSelectionChanged"
                              ContainerContentChanging="OnContainerContentChanging"
                              ContextRequested="OnRowContextRequested" DoubleTapped="OnRowDoubleTapped">
                        <ListView.Resources>
                            <!-- The list's ScrollViewer with the scrollbars in tracks of their own, always
                                 shown: the stock template lays them over the last column and the last
                                 row and fades them out. -->
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ScrollViewer">
                                            <Grid ColumnDefinitions="*,12" RowDefinitions="*,Auto" Background="{TemplateBinding Background}">
                                                <ScrollContentPresenter x:Name="ScrollContentPresenter" ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                        Margin="{TemplateBinding Padding}" />
                                                <ScrollBar x:Name="VerticalScrollBar" Grid.Column="1" Orientation="Vertical" IndicatorMode="MouseIndicator"
                                                           IsTabStop="False" Maximum="{TemplateBinding ScrollableHeight}"
                                                           Value="{TemplateBinding VerticalOffset}" ViewportSize="{TemplateBinding ViewportHeight}"
                                                           Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                                                <ScrollBar x:Name="HorizontalScrollBar" Grid.Row="1" Orientation="Horizontal" IndicatorMode="MouseIndicator"
                                                           IsTabStop="False" Maximum="{TemplateBinding ScrollableWidth}"
                                                           Value="{TemplateBinding HorizontalOffset}" ViewportSize="{TemplateBinding ViewportWidth}"
                                                           Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.Resources>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="MinHeight" Value="24" />
                                <Setter Property="Height" Value="24" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <!-- Rows appear and move without animation (an auto-refresh would animate every second) -->
                        <ListView.ItemContainerTransitions>
                            <TransitionCollection />
                        </ListView.ItemContainerTransitions>
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <!-- The grid restores the scroll offset itself after a reset; item anchoring would move it again -->
                                <ItemsStackPanel ItemsUpdatingScrollMode="KeepScrollOffset" CacheLength="1" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            <!-- A running action (service start/stop, ...): what it is doing, a bar and Cancel -->
            <Grid Grid.Row="1" x:Name="ProgressPanel" Visibility="Collapsed" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12"
                  Padding="12,8,8,8" CornerRadius="4" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                    <TextBlock x:Name="ProgressLabel" TextTrimming="CharacterEllipsis" />
                    <ProgressBar x:Name="ProgressValue" Minimum="0" Maximum="1" />
                </StackPanel>
                <Button Grid.Column="2" x:Name="ProgressCancel" Content="Cancel" Click="OnCancelAction" />
            </Grid>
            <!-- Status bar: counts on the left, refresh state on the right -->
            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <TextBlock x:Name="StatusText" Opacity="0.8" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" x:Name="RefreshText" Opacity="0.8" />
            </Grid>
        </Grid>
    </NavigationView>
    </Grid>
</Window>
