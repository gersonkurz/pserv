#include <windows.h>
#include "../version.h"
1 ICON "../pserv.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION PSERV_VERSION_RC
 PRODUCTVERSION PSERV_VERSION_RC
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS VS_FF_PRERELEASE
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Gerson Kurz\0"
            VALUE "FileDescription", "pserv6 - Windows System Administration\0"
            VALUE "FileVersion", PSERV_VERSION_STRING
            VALUE "InternalName", "pserv6\0"
            VALUE "OriginalFilename", "pserv6.exe\0"
            VALUE "ProductName", "pserv6\0"
            VALUE "ProductVersion", PSERV_VERSION_STRING
            VALUE "LegalCopyright", "Copyright (c) 2025-2026 Gerson Kurz\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
